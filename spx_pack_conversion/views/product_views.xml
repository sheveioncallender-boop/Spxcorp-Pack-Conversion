<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_pack_form" model="ir.ui.view">
        <field name="name">product.template.pack.conversion</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside"><button name="action_spx_pack_rules" type="object" class="oe_stat_button" icon="fa-cubes" groups="spx_pack_conversion.group_pack_user"><field name="spx_pack_rule_count" widget="statinfo" string="Pack Configurations"/></button></xpath>
            <xpath expr="//notebook" position="inside"><page string="Pack Conversion" name="spx_pack_conversion" groups="spx_pack_conversion.group_pack_manager"><group><p>Create a separate case, box or pack containing this product. Each form keeps its own stock and selling price.</p><button name="action_spx_create_pack" type="object" string="Create Pack Product" class="btn-primary" invisible="not is_storable"/></group></page></xpath>
        </field>
    </record>
</odoo>
