<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_pack_form" model="ir.ui.view">
        <field name="name">mrp.production.pack.conversion</field><field name="model">mrp.production</field><field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='origin'][not(ancestor::field)]" position="after"><field name="spx_pack_conversion_id" invisible="not spx_pack_conversion_id" groups="spx_pack_conversion.group_pack_user"/></xpath></field>
    </record>
    <record id="stock_lot_pack_form" model="ir.ui.view">
        <field name="name">stock.lot.pack.source</field><field name="model">stock.lot</field><field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='product_id']" position="after"><field name="spx_pack_source_lot_id" invisible="not spx_pack_source_lot_id" groups="spx_pack_conversion.group_pack_user"/></xpath></field>
    </record>
</odoo>
