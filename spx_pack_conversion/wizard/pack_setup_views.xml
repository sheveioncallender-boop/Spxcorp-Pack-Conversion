<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pack_setup_form" model="ir.ui.view">
        <field name="name">spx.pack.setup.form</field><field name="model">spx.pack.setup</field>
        <field name="arch" type="xml">
            <form string="Create Pack Product">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/><field name="unit_product_id" options="{'no_create': True}"/>
                    <field name="units_per_pack"/><field name="name"/>
                    <field name="currency_id" invisible="1"/><field name="selling_price" widget="monetary"/><field name="cost" widget="monetary"/>
                    <field name="barcode"/><field name="allow_repack"/>
                </group>
                <p>This creates a separate stocked product with its own price and barcode. It does not add inventory. Receive the pack or enter opening stock through normal Inventory operations.</p>
                <footer><button name="action_create_pack" type="object" string="Create Pack" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="action_pack_setup" model="ir.actions.act_window">
        <field name="name">Create Pack Product</field><field name="res_model">spx.pack.setup</field><field name="view_mode">form</field><field name="target">new</field>
    </record>
</odoo>
